# ARGUS — Environment Template
# Copy to `.env.local` (dev) or set in the Vercel dashboard (prod).
# The app runs without keys (keyless feeds). RECON returns 503 when SCANNER_* is empty.
# The agent feed needs Supabase + LLM. Without them the map still works.
SCANNER_URL=
SCANNER_KEY=
CLOUDFLARE_API_TOKEN=
ETHERSCAN_API_KEY=
HELIUS_API_KEY=
FIRMS_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
N2YO_API_KEY=
AIS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
CRON_SECRET=
